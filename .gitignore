# 依赖目录（注意：前端依赖安装在 frontend/ 根下，而 frontend/edu-system-client/.gitignore
# 只能约束其自身目录，两者位置不匹配导致 frontend/node_modules 曾被误提交，故在仓库根统一声明）
node_modules/

# 构建产物
dist/
dist-ssr/
target/
*.tsbuildinfo

# IDE 与编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 测试与覆盖率产物
coverage/
test-results/
playwright-report/
__screenshots__/

# 校验脚本的运行时诊断输出（每次运行都会重写，不入库）
.dsh/verify-p1-ui.diag.json
.dsh/verify-p2-ui.diag.json
.dsh/verify-p3-ui.diag.json
.dsh/verify-p4-ui.diag.json
.dsh/verify-warning-ui.diag.json
# P5 评测的运行态产物：审计水位线（每次 -Mark 重写）与整次运行日志
.dsh/p5-audit-watermark.txt
.dsh/p5-eval-run.log
# 提交信息临时文件（用 git commit -F 时生成，提交完即删；不要入库）
.dsh/commit-msg.txt
.dsh/commit-message-*.txt
.dsh/tmp-commit.txt
.dsh/cm*.txt
# 评测基线等运行日志
.dsh/baseline-*.log

# 系统文件
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 本地环境覆盖（勿提交真实密钥；生产用环境变量注入）
*.local
application-local.yml
