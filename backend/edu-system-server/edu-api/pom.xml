<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.duyell</groupId>
        <artifactId>edu-system-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>edu-api</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <dependencies>
        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Validation 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>1.4.7</version>
        </dependency>

        <dependency>
            <groupId>com.duyell</groupId>
            <artifactId>edu-pojo</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.duyell</groupId>
            <artifactId>edu-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- jwt -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- Spring AI（M2 框架化迁移）
             先只接模型与记忆：Ollama starter（本机 11434，无需云 Key）+ ChatClient + ChatMemory。
             ⚠️ 手写的 OpenAiClient / AiChatService 循环**暂不删除**，留作回归对照（见计划 1.4 注意事项）。
             版本由父 pom 的 spring-ai-bom 统一管理（${spring-ai.version}，本机仓库已有 1.0.9）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-model-chat-memory</artifactId>
        </dependency>
        <!--
          M3（RAG 制度问答）：pgvector 向量库。
          ⚠️ 这里刻意**只引入 starter 的自动配置能力**，但把它的自动装配关掉
          （application.yml 里 `spring.ai.vectorstore.pgvector.enabled: false`），
          改由 duyell.ai.rag.RagConfig 手工装配一个**独立数据源**的 PgVectorStore。
          原因：本应用的主 DataSource 指向 MySQL，而 pgvector 的自动配置会拿主 DataSource
          去建表/建扩展 —— 那会在启动期直接失败（MySQL 没有 vector 类型，实测报 1064）。
          手工装配 + `ai.rag.enabled` 开关，做到"默认关闭、不影响既有 278 项测试、要演示时一行开启"。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!--
                  排除 Mockito：本机离线仓库中解析到的 mockito/byte-buddy 组合在 JDK 21 上
                  无法初始化 MockMaker，而 Spring Boot 的测试支持会在上下文启动时主动探测
                  Mockito，导致所有 @SpringBootTest 用例失败（与是否真的用到 mock 无关）。
                  本项目测试不依赖 Mockito，需要桩时手写即可。
                -->
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


    </dependencies>

    <build>
        <resources>
            <!-- 常规资源 -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              M3（RAG）语料：把仓库里的制度文档**构建期**复制进 jar（classpath:policies/）。
              刻意不手工往 resources 里再拷一份：那样就有两份语料，迟早漂移
              （本项目的教训是"同一事实两处存储必然口径不一致"）。
              语料仍是 docs/policies/*.md 这**一份**，jar 里的只是它的只读副本。
            -->
            <resource>
                <directory>${project.basedir}/../../../docs/policies</directory>
                <targetPath>policies</targetPath>
                <includes>
                    <include>*.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>